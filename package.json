{
  "name": "multi-layer-radial-chart-native",
  "version": "1.0.0",
  "description": "A lightweight, dependency-light React Native + TypeScript library for animated multi-layer radial (activity-ring) charts, rendered with react-native-svg.",
  "license": "MIT",
  "author": "Moshe Hatab",
  "keywords": [
    "react-native",
    "expo",
    "typescript",
    "svg",
    "react-native-svg",
    "data-visualization",
    "radial-chart",
    "activity-rings",
    "progress-ring",
    "charts",
    "animation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MosheHatab/multi-layer-radial-chart-native.git"
  },
  "homepage": "https://github.com/MosheHatab/multi-layer-radial-chart-native#readme",
  "bugs": {
    "url": "https://github.com/MosheHatab/multi-layer-radial-chart-native/issues"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./core": {
      "types": "./lib/typescript/core.d.ts",
      "react-native": "./src/core.ts",
      "import": "./lib/module/core.js",
      "require": "./lib/commonjs/core.js"
    }
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bob build",
    "clean": "rimraf lib",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && node scripts/publish.mjs",
    "check:package": "publint",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "react-native-svg": ">=13.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.3.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "publint": "^0.3.21",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-builder-bob": "^0.32.1",
    "react-native-svg": "^15.8.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
